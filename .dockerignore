# Docker build context is the repository ROOT (so the shared `dcs-commons`
# module is available alongside each service). Keep the context lean: only the
# service source trees + dcs-commons are needed; everything below is excluded.

# VCS & IDE
.git
.github
.idea
.vscode
.devcontainer

# Maven build output (rebuilt inside the image)
**/target

# Node / mobile / docs / infra configs — not needed for the Java service images
mobile-apps
docs
postman
infra
node_modules

# Compose files & local overrides
compose
*.override.yml
.env
.env.*

# Large binary / diagram assets
*.png
*.excalidraw

# Misc
*.md
Makefile
