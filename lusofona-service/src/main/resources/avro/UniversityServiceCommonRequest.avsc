{
  "type": "record",
  "name": "UniversityServiceCommonRequest",
  "namespace": "pt.ulusofona.digital.wallet.domain.avro",
  "doc": "Enhanced Avro schema for common request payloads to the University Rest Services with better type safety and validation",
  "fields": [
    {
      "name": "requestId",
      "type": "string",
      "doc": "Unique request identifier for tracing"
    },
    {
      "name": "userName",
      "type": "string",
      "doc": "Unique identifier for the user. Can be a string (e.g., student ID like 'a12345678')."
    },
    {
      "name": "installKey",
      "type": "string",
      "doc": "A unique identifier for a specific installation of the application on a device (e.g., '00000_0000000000000')."
    },
    {
      "name": "language",
      "type": {
        "type": "enum",
        "name": "LanguageCode",
        "doc": "Supported language codes",
        "symbols": ["PT", "EN", "ES", "FR"]
      },
      "doc": "Preferred language of the user, ISO 639-1 code"
    },
    {
      "name": "platform",
      "type": {
        "type": "enum",
        "name": "PlatformType",
        "doc": "Supported client platforms",
        "symbols": ["ios", "android", "web", "desktop"]
      },
      "doc": "The client platform from which the service request was made"
    },
    {
      "name": "application",
      "type": "string",
      "doc": "The unique identifier (e.g., bundle ID for iOS, package name for Android) of the university's mobile application"
    },
    {
      "name": "versionCode",
      "type": "string",
      "doc": "The internal version code of the client application making the request"
    },
    {
      "name": "requestTimestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Request timestamp in milliseconds since epoch"
    },
    {
      "name": "correlationId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Correlation ID for distributed tracing"
    },
    {
      "name": "clientInfo",
      "type": ["null", {
        "type": "record",
        "name": "ClientInfo",
        "doc": "Additional client information",
        "fields": [
          {
            "name": "deviceModel",
            "type": ["null", "string"],
            "default": null,
            "doc": "Device model information"
          },
          {
            "name": "osVersion",
            "type": ["null", "string"],
            "default": null,
            "doc": "Operating system version"
          },
          {
            "name": "appVersion",
            "type": ["null", "string"],
            "default": null,
            "doc": "Application version"
          }
        ]
      }],
      "default": null,
      "doc": "Additional client information (optional)"
    },
    {
      "name": "requestMetadata",
      "type": ["null", {
        "type": "map",
        "values": "string"
      }],
      "default": null,
      "doc": "Additional request metadata"
    }
  ]
}
