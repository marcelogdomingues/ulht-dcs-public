{
  "type": "record",
  "name": "StudentEvent",
  "namespace": "pt.ulusofona.digital.wallet.domain.avro",
  "doc": "Student-related events for Kafka messaging with enhanced type safety and validation",
  "fields": [
    {
      "name": "eventId",
      "type": "string",
      "doc": "Unique identifier for this event"
    },
    {
      "name": "eventType",
      "type": {
        "type": "enum",
        "name": "StudentEventType",
        "doc": "Type of student event",
        "symbols": [
          "STUDENT_REGISTERED",
          "STUDENT_UPDATED",
          "STUDENT_LOGIN",
          "STUDENT_LOGOUT",
          "STUDENT_DELETED",
          "STUDENT_GRADUATED",
          "STUDENT_SUSPENDED"
        ]
      },
      "doc": "Type of student event"
    },
    {
      "name": "studentId",
      "type": "string",
      "doc": "Unique student identifier"
    },
    {
      "name": "studentCode",
      "type": "string",
      "doc": "Student code (e.g., a12345678)"
    },
    {
      "name": "eventTimestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Event timestamp in milliseconds since epoch"
    },
    {
      "name": "courseInfo",
      "type": {
        "type": "record",
        "name": "CourseInfo",
        "doc": "Course information for the student",
        "fields": [
          {
            "name": "courseCode",
            "type": "int",
            "doc": "Course code identifier"
          },
          {
            "name": "courseName",
            "type": "string",
            "doc": "Course name"
          },
          {
            "name": "degreeCode",
            "type": ["null", "int"],
            "default": null,
            "doc": "Degree code (optional)"
          },
          {
            "name": "degreeName",
            "type": ["null", "string"],
            "default": null,
            "doc": "Degree name (optional)"
          }
        ]
      },
      "doc": "Course information"
    },
    {
      "name": "institutionInfo",
      "type": {
        "type": "record",
        "name": "InstitutionInfo",
        "doc": "Institution information",
        "fields": [
          {
            "name": "institutionCode",
            "type": "int",
            "doc": "Institution code"
          },
          {
            "name": "institutionName",
            "type": "string",
            "doc": "Institution name"
          }
        ]
      },
      "doc": "Institution information"
    },
    {
      "name": "sessionInfo",
      "type": ["null", {
        "type": "record",
        "name": "SessionInfo",
        "doc": "Session information for login/logout events",
        "fields": [
          {
            "name": "sessionId",
            "type": "string",
            "doc": "Session identifier"
          },
          {
            "name": "ipAddress",
            "type": ["null", "string"],
            "default": null,
            "doc": "IP address of the client"
          },
          {
            "name": "userAgent",
            "type": ["null", "string"],
            "default": null,
            "doc": "User agent string"
          },
          {
            "name": "deviceInfo",
            "type": ["null", "string"],
            "default": null,
            "doc": "Device information"
          }
        ]
      }],
      "default": null,
      "doc": "Session information (optional)"
    },
    {
      "name": "eventMetadata",
      "type": ["null", {
        "type": "map",
        "values": "string"
      }],
      "default": null,
      "doc": "Additional event metadata"
    },
    {
      "name": "correlationId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Correlation ID for request tracing"
    }
  ]
}

