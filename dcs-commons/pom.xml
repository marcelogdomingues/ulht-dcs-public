<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Shared building blocks for the DCS microservices.

      This is a STANDALONE installable JAR module (there is deliberately NO
      reactor / aggregator parent tying the four services together, so each
      service keeps building independently from its own directory).

      Because the services depend on this artifact, it must be installed into
      the local Maven repository BEFORE building any service:

          mvn -q -f dcs-commons/pom.xml -DskipTests install

      The service Dockerfiles do exactly that in their build stage.
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example.dcs</groupId>
    <artifactId>dcs-commons</artifactId>
    <version>1.0.0</version>
    <name>DCS Commons</name>
    <description>Shared security and cross-cutting building blocks for the DCS microservices</description>

    <properties>
        <java.version>25</java.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    </properties>

    <dependencies>
        <!-- Spring Web (servlet API, filters) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security (SecurityFilterChain, HttpSecurity, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          OAuth2 Resource Server (JWT / JWKS validation). Version managed by the
          Spring Boot BOM (spring-boot-starter-parent). This adds the CLASSES
          needed to validate an `Authorization: Bearer <jwt>` token, but the JWT
          auth leg is ONLY wired when an issuer-uri property is configured (see
          OAuth2ResourceServerConfiguration). With no issuer-uri set — as in the
          demo and existing runs — the security chain stays api-key only and
          behaves exactly as before.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Auto-configuration support (@AutoConfiguration, conditions) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <!--
              This is a plain library JAR, NOT an executable Spring Boot
              application. Disable the spring-boot-maven-plugin repackage goal
              so the produced jar stays a normal (non-fat) library that other
              modules can depend on.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!--
              JaCoCo test-coverage. Version is managed by the Spring Boot BOM
              (spring-boot-starter-parent). prepare-agent wires the coverage agent
              into the test JVM; report (bound to verify) emits target/site/jacoco/
              (jacoco.xml + HTML). No coverage `check` gate so the build never fails
              on coverage.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
