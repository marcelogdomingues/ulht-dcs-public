{
  // ULHT Digital Credential System — dev container for GitHub Codespaces / VS Code.
  // Open in the cloud, then follow the postCreate message to configure .env and start the stack.
  "name": "ULHT DCS",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "features": {
    // Docker-in-Docker so `docker compose` can run the full stack from inside the container.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // Java 25 (falls back to 21 automatically if 25 is unavailable) with Maven for the Spring Boot services.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Ports published by the stack (services, gateway, monitoring, docs).
  "forwardPorts": [8000, 8084, 8085, 8086, 8087, 3000, 9090, 8081],
  "portsAttributes": {
    "8000": { "label": "Kong Gateway (proxy)" },
    "8084": { "label": "Student Service" },
    "8085": { "label": "Lusofona Service" },
    "8086": { "label": "Credential Service" },
    "8087": { "label": "Fulfilment Service" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" },
    "8081": { "label": "Kafka UI" }
  },

  // Non-destructive welcome message; does not start containers.
  "postCreateCommand": "echo '👋 Welcome to ULHT DCS! To start: 1) cp .env.example .env  2) edit .env and set APP_API_KEY, WALLET_PASSWORD_SECRET, WALLET_PASSWORD_SALT, GRAFANA_ADMIN_PASSWORD, KAFKA_UI_PASSWORD  3) docker compose -f docker-compose.microservices.yml -f docker-compose.override.yml up -d --build  |  Docs: https://marcelogdomingues.github.io/ulht-dcs-public/'",

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-docker",
        "dart-code.dart-code",
        "dart-code.flutter",
        "redhat.vscode-yaml"
      ]
    }
  }
}
