# =============================================================================
# DCS - Environment variables (TEMPLATE)
# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Vars marked REQUIRED have no default; `docker compose up` fails if unset.
# =============================================================================

# --- Backend service secrets (used by dcs-* Spring services) ---
# Shared API key gating service-to-service / gateway calls.
# Compose files: docker-compose.yml, docker-compose.microservices.yml
#                (credential/student/fulfilment/sis services)
APP_API_KEY=dcs-dev-local-CHANGE-ME

# Allowed CORS origins (comma-separated). Default targets the Kong proxy.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8000

# University Student Information System (SIS) base URL used by sis-service.
# Optional: overrides the built-in default in application.yml. Set this to point
# at your institution's SIS endpoint.
# SIS_API_URL=https://your-sis-endpoint/api

# --- Wallet password derivation (credential-service ONLY) --- REQUIRED
# Used by dcs-credential-service to derive/encrypt wallet passwords.
# Compose files: docker-compose.yml, docker-compose.microservices.yml,
#                docker-compose.dev.yml
WALLET_PASSWORD_SECRET=change-me-generate-a-long-random-secret
WALLET_PASSWORD_SALT=change-me-generate-a-random-salt

# --- Grafana admin (monitoring) ---
# Compose file: docker-compose.infrastructure.yml
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password   # REQUIRED

# --- Kafka UI login (kafbat/kafka-ui) ---
# Compose files: docker-compose.yml, docker-compose.microservices.yml,
#                docker-compose.infrastructure.yml, docker-compose.dev.yml
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me-kafka-ui-password             # REQUIRED

# --- JVM sizing (optional, used by kafka-ui JVM_OPTS) ---
JVM_XMS=-Xms256m
JVM_XMX=-Xmx512m

# --- MySQL (present in existing .env; not currently wired into any compose
#     service, kept for parity / future use) ---
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_USER=change-me-mysql-user
MYSQL_PASSWORD=change-me-mysql-password

# --- Kafka ---
# The broker runs in KRaft mode (no ZooKeeper); listeners are configured in the
# compose files, so these env vars are not required. Kept only for reference.
# KAFKA_ADVERTISED_LISTENERS=CLIENT://kafka:9092,EXTERNAL://localhost:29092

# --- PostgreSQL (fulfilment-service durable store) ---
# Compose files: docker-compose.microservices.yml
POSTGRES_USER=dcs
POSTGRES_PASSWORD=change-me-postgres-password              # REQUIRED
